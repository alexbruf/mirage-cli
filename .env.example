# Sample env vars used by individual @mirage-cli/* wrappers during local
# development. Real values go in .env (which is gitignored). Each wrapper
# documents which vars it needs in its own README.

# @mirage-cli/firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_NO_TELEMETRY=1

# @mirage-cli/reddit
REDDIT_API_HOST=https://reddit.viewengine.ai
REDDIT_API_KEY=
# Staging/other Clerk tenants only (prod has built-in defaults):
# REDDIT_CLI_OAUTH_ISSUER=
# REDDIT_CLI_OAUTH_CLIENT_ID=

# @mirage-cli/radar
RADAR_API_HOST=https://radar.viewengine.ai
RADAR_OAUTH_ACCESS_TOKEN=

# @mirage-cli/pulse
PULSE_API_HOST=https://pulse.viewengine.ai
PULSE_OAUTH_ACCESS_TOKEN=

# @mirage-cli/presscart
PRESSCART_API_HOST=https://api.presscart.com
PRESSCART_API_TOKEN=

# @mirage-cli/clarity
CLARITY_API_TOKEN=

# @mirage-cli/seogets
SEOGETS_MCP_TOKEN=
# SEOGETS_MCP_URL=https://app.seogets.com/mcp   # optional override

# @mirage-cli/ga4
# Targeting:
GA_PROPERTY_ID=
# GA_PROFILE=                                   # named ~/.config/google-analytics-cli/profiles/<name>.json
# Auth — pick one:
# GA4_OAUTH_ACCESS_TOKEN=                       # raw bearer (no refresh)
# GA4_OAUTH_CLIENT_ID=                          # for `ga4 login` (Google Desktop OAuth client)
# GA4_OAUTH_CLIENT_SECRET=
# GA4_OAUTH_SCOPES=                             # default: https://www.googleapis.com/auth/analytics.readonly
# GOOGLE_APPLICATION_CREDENTIALS=               # path to service account JSON

# Future wrappers
# DATAFORSEO_USERNAME=
# DATAFORSEO_PASSWORD=
# AHREFS_API_KEY=
