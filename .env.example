# Sample env vars used by individual @mirage-cli/* wrappers during local
# development. Real values go in .env (which is gitignored). Each wrapper
# documents which vars it needs in its own README.

# @mirage-cli/firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_NO_TELEMETRY=1

# @mirage-cli/reddit
REDDIT_API_HOST=https://reddit.viewengine.ai
REDDIT_API_KEY=
# Staging/other Clerk tenants only (prod has built-in defaults):
# REDDIT_CLI_OAUTH_ISSUER=
# REDDIT_CLI_OAUTH_CLIENT_ID=

# @mirage-cli/radar
RADAR_API_HOST=https://radar.viewengine.ai
RADAR_OAUTH_ACCESS_TOKEN=

# @mirage-cli/pulse
PULSE_API_HOST=https://pulse.viewengine.ai
PULSE_OAUTH_ACCESS_TOKEN=

# @mirage-cli/presscart
PRESSCART_API_HOST=https://api.presscart.com
PRESSCART_API_TOKEN=

# @mirage-cli/clarity
CLARITY_API_TOKEN=

# @mirage-cli/gbp
# Google Business Profile via the Windsor.ai google_my_business connector.
# Get a key from https://onboard.windsor.ai/app/data-preview
WINDSOR_API_KEY=

# @mirage-cli/seogets
SEOGETS_MCP_TOKEN=
# SEOGETS_MCP_URL=https://app.seogets.com/mcp   # optional override

# @mirage-cli/ga4
# Targeting:
GA_PROPERTY_ID=
# GA_PROFILE=                                   # named ~/.config/google-analytics-cli/profiles/<name>.json
# Auth — pick one:
# GA4_OAUTH_ACCESS_TOKEN=                       # raw bearer (no refresh)
# GA4_OAUTH_CLIENT_ID=                          # for `ga4 login` (Google Desktop OAuth client)
# GA4_OAUTH_CLIENT_SECRET=
# GA4_OAUTH_SCOPES=                             # default: https://www.googleapis.com/auth/analytics.readonly
# GOOGLE_APPLICATION_CREDENTIALS=               # path to service account JSON

# @mirage-cli/callrail
# Single key (simplest):
CALLRAIL_API_KEY=
# Or multiple keys as named profiles — "name:key,name2:key2" or a JSON object
# {"name":{"apiKey":"...","accountId":"ACC..."}}. Select with --profile / CALLRAIL_PROFILE.
# CALLRAIL_API_KEYS=
# CALLRAIL_PROFILE=
# CALLRAIL_ACCOUNT_ID=                          # account override (auto-detected if the key sees one)
# CALLRAIL_API_BASE_URL=https://api.callrail.com/v3

# @mirage-cli/hubspot
# Simplest: a private app access token (or any OAuth/access token), used as a bearer.
HUBSPOT_ACCESS_TOKEN=
# Or a personal access key (the credential `hs account auth` uses), exchanged for a
# short-lived token at call time. Optionally pin a portal with HUBSPOT_ACCOUNT_ID.
# HUBSPOT_PERSONAL_ACCESS_KEY=
# HUBSPOT_ACCOUNT_ID=
# HUBSPOT_API_BASE_URL=https://api.hubapi.com
# On a workstation, no env is needed — the CLI reuses ~/.hscli/config.yml
# (run `hs account auth`); select an account with --account <name|id>.

# @mirage-cli/airtable
# A personal access token from https://airtable.com/create/tokens (used as a bearer):
AIRTABLE_API_KEY=
# Default base id appXXXXXXXX (per command: --baseId). Find one with `airtable list-bases`.
# AIRTABLE_BASE_ID=
# AIRTABLE_API_BASE_URL=https://api.airtable.com/v0

# @mirage-cli/ve-fanout
# Bearer access token (recommended for runtimes / headless use). Or run
# `ve-fanout login` for an interactive browser sign-in (caches to ~/.config/ve-fanout).
VE_FANOUT_TOKEN=
# VE_FANOUT_ORG_ID=                             # pin an organization (else the active org / --org)
# VE_FANOUT_API_URL=https://fanout.api.viewengine.ai
# VE_FANOUT_CONFIG_DIR=                         # override the credential cache dir

# @mirage-cli/openrouter
OPENROUTER_API_KEY=
# OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_TITLE=

# @mirage-cli/rapidurlindexer
RAPIDURLINDEXER_API_KEY=
# RAPIDURLINDEXER_API_BASE_URL=https://rapidurlindexer.com/wp-json

# @mirage-cli/contentdynamite
VE_DYNAMITE_TOKEN=
# VE_DYNAMITE_API_URL=https://api.dynamate.ai

# Future wrappers
# DATAFORSEO_USERNAME=
# DATAFORSEO_PASSWORD=
# AHREFS_API_KEY=
