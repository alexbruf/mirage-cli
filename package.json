{
  "name": "mirage-cli",
  "private": true,
  "version": "0.0.0",
  "description": "Wrap Commander.js TS CLIs as importable @mirage-cli/* packages for mirage runtimes and Cloudflare Workers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbruf/mirage-cli.git"
  },
  "bugs": {
    "url": "https://github.com/alexbruf/mirage-cli/issues"
  },
  "homepage": "https://github.com/alexbruf/mirage-cli#readme",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "test:worker": "bun run --filter '@mirage-cli/core' test:worker",
    "typecheck": "bun run --filter '*' typecheck",
    "changeset": "bunx changeset",
    "version": "bunx changeset version",
    "release": "bun run build && bun scripts/release.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@mirage-cli/ahrefs": "workspace:*",
    "@mirage-cli/airtable": "workspace:*",
    "@mirage-cli/airtable-cli": "workspace:*",
    "@mirage-cli/call": "workspace:*",
    "@mirage-cli/callrail": "workspace:*",
    "@mirage-cli/clarity": "workspace:*",
    "@mirage-cli/contentdynamite": "workspace:*",
    "@mirage-cli/contentdynamite-cli": "workspace:*",
    "@mirage-cli/core": "workspace:*",
    "@mirage-cli/dataforseo": "workspace:*",
    "@mirage-cli/firecrawl": "workspace:*",
    "@mirage-cli/ga4": "workspace:*",
    "@mirage-cli/gbp": "workspace:*",
    "@mirage-cli/gbp-cli": "workspace:*",
    "@mirage-cli/hubspot": "workspace:*",
    "@mirage-cli/hubspot-cli": "workspace:*",
    "@mirage-cli/ics": "workspace:*",
    "@mirage-cli/localfalcon": "workspace:*",
    "@mirage-cli/localfalcon-cli": "workspace:*",
    "@mirage-cli/oura": "workspace:*",
    "@mirage-cli/openrouter": "workspace:*",
    "@mirage-cli/openrouter-cli": "workspace:*",
    "@mirage-cli/presscart": "workspace:*",
    "@mirage-cli/pulse": "workspace:*",
    "@mirage-cli/radar": "workspace:*",
    "@mirage-cli/reddit": "workspace:*",
    "@mirage-cli/rapidurlindexer": "workspace:*",
    "@mirage-cli/rapidurlindexer-cli": "workspace:*",
    "@mirage-cli/seogets": "workspace:*",
    "@mirage-cli/sms": "workspace:*",
    "@mirage-cli/timing": "workspace:*",
    "@mirage-cli/ve-fanout": "workspace:*",
    "@mirage-cli/ve-fanout-cli": "workspace:*",
    "@struktoai/mirage-core": "^0.0.1",
    "@struktoai/mirage-node": "^0.0.1",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
