{
  "name": "@mirage-cli/ahrefs-cli",
  "version": "0.1.11",
  "description": "Ahrefs API v3 — CLI and programmatic library. Mirage-compatible command shape.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbruf/mirage-cli.git",
    "directory": "packages/ahrefs-cli"
  },
  "bugs": {
    "url": "https://github.com/alexbruf/mirage-cli/issues"
  },
  "homepage": "https://github.com/alexbruf/mirage-cli/tree/main/packages/ahrefs-cli#readme",
  "keywords": [
    "ahrefs",
    "seo",
    "cli",
    "api",
    "keywords",
    "backlinks",
    "mirage"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "bun": "./src/cli.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "ahrefs": "./dist/bin.js"
  },
  "files": [
    "dist",
    "openapi",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/bin.ts src/cli.ts src/index.ts --target=node --outdir=dist --external cli-table3 --external commander --external picocolors && bun run scripts/postbuild.ts && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "spec:refresh": "bun run tools/build-spec.ts && bunx openapi-typescript openapi/ahrefs.json -o src/generated/api-types.ts",
    "test": "bun test --reporter=dots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@struktoai/mirage-core": "^0.0.1",
    "openapi-typescript": "^7.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18.0.0"
  }
}
