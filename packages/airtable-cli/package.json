{
  "name": "@mirage-cli/airtable-cli",
  "version": "0.1.0",
  "description": "Airtable CLI — read-only access to the Airtable Web API (bases, table schema, records). Command names mirror the Airtable MCP read tools (list-bases, list-tables, describe-table, list-records, search-records, get-record, whoami). Mirage-compatible command shape.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbruf/mirage-cli.git",
    "directory": "packages/airtable-cli"
  },
  "bugs": {
    "url": "https://github.com/alexbruf/mirage-cli/issues"
  },
  "homepage": "https://github.com/alexbruf/mirage-cli/tree/main/packages/airtable-cli#readme",
  "keywords": [
    "airtable",
    "cli",
    "mirage"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "bun": "./src/cli.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "airtable": "./dist/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/bin.ts src/cli.ts src/index.ts --target=node --outdir=dist --external commander && bun run scripts/postbuild.ts && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "bun test --reporter=dots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18.0.0"
  }
}
