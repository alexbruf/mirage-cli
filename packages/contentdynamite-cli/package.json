{
  "name": "@mirage-cli/contentdynamite-cli",
  "version": "1.0.0",
  "description": "The Content Dynamite CLI (ve-dynamite): SEO articles, Google Business Profile posts, BOFU landing pages, company profiles, ICP, design systems, revisions and featured images over the Content Dynamite API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbruf/mirage-cli.git",
    "directory": "packages/contentdynamite-cli"
  },
  "bugs": {
    "url": "https://github.com/alexbruf/mirage-cli/issues"
  },
  "homepage": "https://github.com/alexbruf/mirage-cli/tree/main/packages/contentdynamite-cli#readme",
  "keywords": [
    "content-dynamite",
    "ve-dynamite",
    "seo",
    "landing-pages",
    "google-business-profile",
    "cli",
    "mirage"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ve-dynamite": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/bin.ts",
    "build": "rm -rf dist && bun build src/index.ts src/bin.ts --target=node --outdir=dist --splitting --external commander --external zod && bun run build:types && bun run scripts/postbuild.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "bun test --reporter=dots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18.0.0"
  }
}
