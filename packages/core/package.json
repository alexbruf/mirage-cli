{
  "name": "@mirage-cli/core",
  "version": "0.1.11",
  "description": "Wrap any Commander.js CLI for in-process execution. ALS-isolated, streaming stdout/stderr, ByteSource stdin, Cloudflare Worker-compatible.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --dts --external commander --clean --silent",
    "test": "bun test --reporter=dots",
    "test:worker": "wrangler dev --port 3003 --local --log-level=warn & sleep 3 && bun tests/drive-worker.ts; ec=$?; kill %1 2>/dev/null; exit $ec",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "commander": ">=11"
  },
  "devDependencies": {
    "commander": "^12.1.0",
    "firecrawl-cli": "^1.18.0",
    "tsup": "^8.5.1",
    "wrangler": "^4.93.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbruf/mirage-cli.git",
    "directory": "packages/core"
  },
  "keywords": [
    "commander",
    "cli",
    "cloudflare-workers",
    "mirage",
    "in-process",
    "streaming"
  ],
  "license": "MIT"
}
