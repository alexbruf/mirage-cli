{
  "name": "@mirage-cli/image",
  "version": "0.0.0",
  "description": "Pure-JS, Cloudflare Worker-safe image utilities. Strip EXIF/XMP/C2PA provenance metadata from JPEG/PNG/WebP without re-encoding.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --dts --clean --silent",
    "test": "bun test --reporter=dots",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbruf/mirage-cli.git",
    "directory": "packages/image"
  },
  "keywords": [
    "image",
    "metadata",
    "exif",
    "xmp",
    "c2pa",
    "strip",
    "cloudflare-workers",
    "mirage"
  ],
  "license": "MIT"
}
