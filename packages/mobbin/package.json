{
  "name": "@mirage-cli/mobbin",
  "version": "0.1.0",
  "description": "Mobbin CLI as an importable mirage / Cloudflare-Worker command via @mirage-cli/core.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --dts --external @mirage-cli/core --external @mirage-cli/mobbin-cli --external commander --external @struktoai/mirage-core --clean --silent",
    "test": "bun test --reporter=dots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mirage-cli/core": "workspace:^"
  },
  "peerDependencies": {
    "@struktoai/mirage-core": ">=0.0.1",
    "@mirage-cli/mobbin-cli": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@struktoai/mirage-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@struktoai/mirage-core": "^0.0.1",
    "commander": "^14.0.3",
    "tsup": "^8.5.1",
    "@mirage-cli/mobbin-cli": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexbruf/mirage-cli.git",
    "directory": "packages/mobbin"
  },
  "keywords": [
    "mobbin",
    "design",
    "ui",
    "commander",
    "mirage",
    "cloudflare-workers"
  ],
  "license": "MIT"
}
