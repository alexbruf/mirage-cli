{
  "name": "@mirage-cli/openrouter-cli",
  "version": "0.1.0",
  "description": "OpenRouter CLI for model discovery, quota inspection, generation metadata, and chat completions through a fetch-only, Mirage-compatible command surface.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbruf/mirage-cli.git",
    "directory": "packages/openrouter-cli"
  },
  "bugs": {
    "url": "https://github.com/alexbruf/mirage-cli/issues"
  },
  "homepage": "https://github.com/alexbruf/mirage-cli/tree/main/packages/openrouter-cli#readme",
  "keywords": [
    "openrouter",
    "llm",
    "ai",
    "cli",
    "mirage"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "bun": "./src/cli.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "openrouter": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/bin.ts",
    "build": "bun build src/bin.ts src/cli.ts src/client.ts src/config.ts src/index.ts src/output.ts --target=node --outdir=dist --external commander && bun run scripts/postbuild.ts && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "bun test --reporter=dots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18.0.0"
  }
}
