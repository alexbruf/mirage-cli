{
  "name": "@mirage-cli/rapidurlindexer-cli",
  "version": "0.1.0",
  "description": "Typed Rapid URL Indexer API client and CLI for projects, reports, and credit balance.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbruf/mirage-cli.git",
    "directory": "packages/rapidurlindexer-cli"
  },
  "bugs": {
    "url": "https://github.com/alexbruf/mirage-cli/issues"
  },
  "homepage": "https://github.com/alexbruf/mirage-cli/tree/main/packages/rapidurlindexer-cli#readme",
  "keywords": [
    "rapid-url-indexer",
    "indexing",
    "seo",
    "cli",
    "mirage"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "bun": "./src/cli.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "rapidurlindexer": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/bin.ts",
    "build": "bun build src/bin.ts src/cli.ts src/index.ts --target=node --outdir=dist --external commander && bun run scripts/postbuild.ts && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "bun test --reporter=dots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@mirage-cli/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18.0.0"
  }
}
