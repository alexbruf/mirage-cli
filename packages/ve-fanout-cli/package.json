{
  "name": "@mirage-cli/ve-fanout-cli",
  "version": "0.1.0",
  "description": "VE Fanout CLI — query fan-out for AI visibility: submit a query and see the sub-queries ChatGPT, Gemini (AI Overviews/AI Mode) and Perplexity generate. Mirage / Cloudflare-Worker compatible.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbruf/mirage-cli.git",
    "directory": "packages/ve-fanout-cli"
  },
  "bugs": {
    "url": "https://github.com/alexbruf/mirage-cli/issues"
  },
  "homepage": "https://github.com/alexbruf/mirage-cli/tree/main/packages/ve-fanout-cli#readme",
  "keywords": [
    "ve-fanout",
    "query-fan-out",
    "fanout",
    "ai-visibility",
    "ai-search",
    "ai-overviews",
    "ai-mode",
    "llm-seo",
    "viewengine",
    "cli",
    "mirage"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "bun": "./src/cli.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "ve-fanout": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/bin.ts src/cli.ts src/index.ts --target=node --outdir=dist --external commander --external open && bun run scripts/postbuild.ts && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "bun test --reporter=dots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "open": "^11.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18.0.0"
  }
}
