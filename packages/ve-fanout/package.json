{
  "name": "@mirage-cli/ve-fanout",
  "version": "0.1.0",
  "description": "VE Fanout CLI (AI query fan-out) as an importable mirage / Cloudflare-Worker command via @mirage-cli/core.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --dts --external @mirage-cli/core --external @mirage-cli/ve-fanout-cli --external commander --external @struktoai/mirage-core --clean --silent",
    "test": "bun test --reporter=dots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mirage-cli/core": "workspace:^"
  },
  "peerDependencies": {
    "@struktoai/mirage-core": ">=0.0.1",
    "@mirage-cli/ve-fanout-cli": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@struktoai/mirage-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mirage-cli/ve-fanout-cli": "workspace:^",
    "@struktoai/mirage-core": "^0.0.1",
    "commander": "^14.0.3",
    "tsup": "^8.5.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbruf/mirage-cli.git",
    "directory": "packages/ve-fanout"
  },
  "keywords": [
    "ve-fanout",
    "query-fan-out",
    "fanout",
    "ai-visibility",
    "ai-search",
    "viewengine",
    "commander",
    "mirage",
    "cloudflare-workers"
  ],
  "license": "MIT"
}
