{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["bun"],

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "baseUrl": ".",
    "paths": {
      "@mirage-cli/core": ["./packages/core/src/index.ts"],
      "@mirage-cli/core/*": ["./packages/core/src/*"],
      "@mirage-cli/dataforseo-cli": ["./packages/dataforseo-cli/src/index.ts"],
      "@mirage-cli/dataforseo-cli/*": ["./packages/dataforseo-cli/src/*"],
      "@mirage-cli/ahrefs-cli": ["./packages/ahrefs-cli/src/index.ts"],
      "@mirage-cli/ahrefs-cli/*": ["./packages/ahrefs-cli/src/*"],
      "@mirage-cli/reddit-cli": ["./packages/reddit-cli/src/index.ts"],
      "@mirage-cli/reddit-cli/*": ["./packages/reddit-cli/src/*"],
      "@mirage-cli/radar-cli": ["./packages/radar-cli/src/index.ts"],
      "@mirage-cli/radar-cli/*": ["./packages/radar-cli/src/*"],
      "@mirage-cli/pulse-cli": ["./packages/pulse-cli/src/index.ts"],
      "@mirage-cli/pulse-cli/*": ["./packages/pulse-cli/src/*"],
      "@mirage-cli/presscart-cli": ["./packages/presscart-cli/src/index.ts"],
      "@mirage-cli/presscart-cli/*": ["./packages/presscart-cli/src/*"],
      "@mirage-cli/clarity-cli": ["./packages/clarity-cli/src/index.ts"],
      "@mirage-cli/clarity-cli/*": ["./packages/clarity-cli/src/*"],
      "@mirage-cli/seogets-cli": ["./packages/seogets-cli/src/index.ts"],
      "@mirage-cli/seogets-cli/*": ["./packages/seogets-cli/src/*"],
      "@mirage-cli/ga4-cli": ["./packages/ga4-cli/src/index.ts"],
      "@mirage-cli/ga4-cli/*": ["./packages/ga4-cli/src/*"],
      "@mirage-cli/oura-cli": ["./packages/oura-cli/src/index.ts"],
      "@mirage-cli/oura-cli/*": ["./packages/oura-cli/src/*"],
      "@mirage-cli/ics-cli": ["./packages/ics-cli/src/index.ts"],
      "@mirage-cli/ics-cli/*": ["./packages/ics-cli/src/*"],
      "@mirage-cli/timing-cli": ["./packages/timing-cli/src/index.ts"],
      "@mirage-cli/timing-cli/*": ["./packages/timing-cli/src/*"],
      "@mirage-cli/sms-cli": ["./packages/sms-cli/src/index.ts"],
      "@mirage-cli/sms-cli/*": ["./packages/sms-cli/src/*"],
      "@mirage-cli/call-cli": ["./packages/call-cli/src/index.ts"],
      "@mirage-cli/call-cli/*": ["./packages/call-cli/src/*"],
      "@mirage-cli/callrail-cli": ["./packages/callrail-cli/src/index.ts"],
      "@mirage-cli/callrail-cli/*": ["./packages/callrail-cli/src/*"],
      "@mirage-cli/gbp-cli": ["./packages/gbp-cli/src/index.ts"],
      "@mirage-cli/gbp-cli/*": ["./packages/gbp-cli/src/*"],
      "@mirage-cli/localfalcon-cli": ["./packages/localfalcon-cli/src/index.ts"],
      "@mirage-cli/localfalcon-cli/*": ["./packages/localfalcon-cli/src/*"],
      "@mirage-cli/openrouter-cli": ["./packages/openrouter-cli/src/index.ts"],
      "@mirage-cli/openrouter-cli/*": ["./packages/openrouter-cli/src/*"],
      "@mirage-cli/rapidurlindexer-cli": ["./packages/rapidurlindexer-cli/src/index.ts"],
      "@mirage-cli/rapidurlindexer-cli/*": ["./packages/rapidurlindexer-cli/src/*"],
      "@mirage-cli/hubspot-cli": ["./packages/hubspot-cli/src/index.ts"],
      "@mirage-cli/hubspot-cli/*": ["./packages/hubspot-cli/src/*"],
      "@mirage-cli/airtable-cli": ["./packages/airtable-cli/src/index.ts"],
      "@mirage-cli/airtable-cli/*": ["./packages/airtable-cli/src/*"],
      "@mirage-cli/ve-fanout-cli": ["./packages/ve-fanout-cli/src/index.ts"],
      "@mirage-cli/ve-fanout-cli/*": ["./packages/ve-fanout-cli/src/*"]
    }
  }
}
