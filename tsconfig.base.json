{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["bun"],

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "baseUrl": ".",
    "paths": {
      "@mirage-cli/core": ["./packages/core/src/index.ts"],
      "@mirage-cli/core/*": ["./packages/core/src/*"],
      "@mirage-cli/dataforseo-cli": ["./packages/dataforseo-cli/src/index.ts"],
      "@mirage-cli/dataforseo-cli/*": ["./packages/dataforseo-cli/src/*"],
      "@mirage-cli/ahrefs-cli": ["./packages/ahrefs-cli/src/index.ts"],
      "@mirage-cli/ahrefs-cli/*": ["./packages/ahrefs-cli/src/*"]
    }
  }
}
